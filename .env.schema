# @defaultSensitive=false @defaultRequired=false
# ---

# Optional path to the Agents TOML configuration.
AGENTS_CONFIG=

# @type=enum(opencode,claude,mock)
# Optional provider override for the local Herdr execution backend.
AGENTS_PROVIDER=

# Optional model override for the selected provider.
AGENTS_MODEL=
# Optional effort paired with AGENTS_MODEL.
AGENTS_EFFORT=
# @type=enum(host,container)
# Optional execution isolation override.
AGENTS_ISOLATION=
# Optional OCI image reference override for per-agent containers.
AGENTS_CONTAINER_IMAGE=



# @type=port
# Optional web server port override.
AGENTS_WEB_PORT=

# @sensitive
# Optional fixed web login token. Omit to use the generated state-file token.
AGENTS_WEB_TOKEN=

# @sensitive
# OpenCode authentication JSON required only for per-agent OpenCode containers.
OPENCODE_AUTH_JSON=

# @sensitive
# Claude Code setup token required only for per-agent Claude containers.
CLAUDE_CODE_OAUTH_TOKEN=
